# ==========================================
# Grade Flow App - Environment Configuration
# ==========================================

# Client-Side Supabase Variables (Vite public prefix)
# Used by frontend client in app/src/services/supabaseDatabase.ts
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Serverless & Administrative Variables
# Used by Vercel serverless function in app/api/manage-users.ts
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# Database Direct Connection String
# Used by migration scripts and pooler connections
POSTGRES_URL="postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require"
SUPABASE_DB_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres"

# Optional Applet Config
APP_URL="https://gradeflow.your-domain.com"
