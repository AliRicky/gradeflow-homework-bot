# ══════════════════════════════════════════════════════════════════════
# UNIFIED GRADE FLOW & TELEGRAM BOT ENVIRONMENT CONFIGURATION
# Copy this file to .env or set variables in your cloud deployment platform.
# ══════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────
# 1. TELEGRAM HOMEWORK COLLECTOR BOT & TMA ADMIN HUB
# ──────────────────────────────────────────────────────────────────────
# Telegram Bot API token from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_example

# Public Webhook / App Host URL (e.g., https://your-deployment.vercel.app)
WEBHOOK_HOST=https://your-deployment.vercel.app

# Telegram Supergroup ID for archive and forum topics (negative int)
ARCHIVE_GROUP_ID=-1001234567890

# Forum Topic IDs (message_thread_id) for homework assignments
TOPIC_HW1=2
TOPIC_HW2=4
TOPIC_HW3=6
TOPIC_HW4=8
TOPIC_HW5=10

# Comma-separated list of admin Telegram chat IDs
ADMIN_CHAT_IDS=123456789,987654321

# Course registration password for student verification
REGISTRATION_PASSWORD=CE401_Fall2026

# Optional 12-Factor Roster: Inline CSV data for cloud/serverless environments
# ROSTER_CSV="student_id,name\n401001,Alice Smith\n401002,Bob Johnson"
ROSTER_CSV=

# ──────────────────────────────────────────────────────────────────────
# 2. SUPABASE POSTGRESQL (SHARED PERSISTENCE LAYER)
# ──────────────────────────────────────────────────────────────────────
# Unified PostgreSQL Connection URL (Used by Python bot & Supabase migrations)
POSTGRES_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# Supabase API Endpoint & Public Anonymous Key (Used by Grade Flow frontend)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Supabase Service Role Key (Used exclusively by server-side APIs)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Application Base URL
APP_URL=https://gradeflow.your-domain.com
