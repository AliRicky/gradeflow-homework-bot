# Telegram Bot Token from @BotFather
BOT_TOKEN=

# Webhook host URL for Telegram Mini App & Webhook endpoints (e.g. https://your-domain.vercel.app)
WEBHOOK_HOST=

# Archive Supergroup ID (typically a negative integer like -100xxxxxxxxxx)
ARCHIVE_GROUP_ID=

# Forum Topic IDs (message_thread_id) for each homework assignment
TOPIC_HW1=
TOPIC_HW2=
TOPIC_HW3=
TOPIC_HW4=
TOPIC_HW5=

# Comma-separated list of admin chat IDs allowed to run management commands
ADMIN_CHAT_IDS=

# Optional: PostgreSQL Database URL (Supabase/Neon) for production persistence
POSTGRES_URL=

# Shared Course Registration Password (required for student verification during registration)
REGISTRATION_PASSWORD=CE401_Fall2026

# Optional 12-Factor Roster: Paste your course roster CSV content directly (for cloud / Vercel serverless)
# ROSTER_CSV="student_id,name\n401001,Alice Smith\n401002,Bob Johnson"
ROSTER_CSV=
